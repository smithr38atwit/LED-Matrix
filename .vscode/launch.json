	"version": "0.2.0",
	"configurations": [
		{
			"name": "LED Matrix API (main.py)",
			"type": "debugpy",
			"request": "launch",
			"program": "${workspaceFolder}/main.py",
			"console": "integratedTerminal",
			"serverReadyAction": {
				"action": "openExternally",
				"pattern": "Uvicorn running on (https?://\\S+)",
				"uriFormat": "%s/docs"
			}
		}
	]
