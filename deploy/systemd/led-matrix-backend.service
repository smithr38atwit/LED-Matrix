[Unit]
Description=LED Matrix backend
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ryan.smith/led-matrix
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ryan.smith/led-matrix/.venv/bin/python /home/ryan.smith/led-matrix/main.py
Restart=always
RestartSec=5

# The rgbmatrix driver commonly needs root access on Raspberry Pi hardware.
User=root
Group=root

[Install]
WantedBy=multi-user.target